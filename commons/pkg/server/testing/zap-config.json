{
  "development": true,
  "encoding": "console",
  "outputPaths": [
    "stdout"
  ],
  "errorOutputPaths": [
    "stderr"
  ],
  "disableCaller": false,
  "disableStacktrace": false,
  "sampling": null,
  "encoderConfig": {
    "messageKey": "msg",
    "levelKey": "level",
    "timeKey": "ts",
    "nameKey": "logger",
    "callerKey": "caller",
    "functionKey": "",
    "stacktraceKey": "stacktrace",
    "lineEnding": "\n",
    "levelEncoder": "capitalColor",
    "timeEncoder": "iso8601",
    "durationEncoder": "string",
    "callerEncoder": "short"
  }
}
