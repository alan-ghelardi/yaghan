---
# Rendered into the per-run config directory by suite_test.go.
# Mirrors api-server/dev/config.yaml since the e2e suite reuses the
# same DynamoDB Local + Redis containers and ports.

grpc-port: 9090
rest-port: 9092

keep-alive:
  min-time: 30s
  interval: 30s
  timeout: 20s

max-concurrent-streams: 4294967295

logger:
  log-level: debug
  zap-config:
    development: true
    encoding: console
    outputPaths:
      - stdout
    errorOutputPaths:
      - stderr
    disableCaller: false
    disableStacktrace: false
    sampling:
    encoderConfig:
      messageKey: msg
      levelKey: level
      timeKey: ts
      nameKey: logger
      callerKey: caller
      functionKey: ""
      stacktraceKey: stacktrace
      lineEnding: "\n"
      levelEncoder: capital
      timeEncoder: iso8601
      durationEncoder: string
      callerEncoder: short

database:
  aws:
    sandboxes-table-name: sandboxes
    nodes-table-name: nodes
    snapshots-table-name: snapshots
    endpoint-url: http://localhost:8000

watch-stream:
  event-delivery-timeout: 30s
  redis:
    address: localhost:6379
    stream-name: yaghan
    stream-key: yaghan
    max-stream-length: 1000
    key-ttl: 24h
    timeout: 30s
    stream-readiness-timeout: 1m
